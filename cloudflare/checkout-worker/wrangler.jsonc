{
  "name": "smoke-cali-checkout",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "vars": {
    "SITE_URL": "https://smokecali.co.uk",
    // Live Viva.com payments. Keep this "live" unless you are deliberately testing.
    // LIVE credentials must stay set as worker secrets (see VIVA-SETUP.md).
    "VIVA_ENV": "live"
  }
}
