# Local Worker secrets for `npm run checkout` — never commit the real .dev.vars file.
# Copy this file to .dev.vars and fill in DEMO credentials first (see VIVA-SETUP.md).
VIVA_ENV=demo
VIVA_CLIENT_ID=
VIVA_CLIENT_SECRET=
VIVA_SOURCE_CODE=
# Needed only for the webhook "Verify" step:
VIVA_MERCHANT_ID=
VIVA_API_KEY=
# Optional order notifications:
ZAPIER_WEBHOOK_URL=
RESEND_API_KEY=
OWNER_NOTIFY_EMAIL=hello@calipacks.co.uk
RESEND_FROM_EMAIL=Smoke Cali <orders@smokecali.co.uk>
SITE_URL=https://smokecali.co.uk
